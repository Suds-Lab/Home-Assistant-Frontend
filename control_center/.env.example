# Standalone (dev) configuration. Copy to .env and fill in.
# Not used when running as a Home Assistant add-on (Supervisor handles it).

# URL of your Home Assistant instance (no trailing slash).
HA_URL=http://homeassistant.local:8123

# Long-lived access token: HA -> profile (bottom left) -> Security tab ->
# "Long-lived access tokens" -> Create Token.
HA_TOKEN=

# Secret used to sign login sessions. Leave blank to auto-generate and persist
# a random one (recommended); set a value only to pin your own.
JWT_SECRET=

# App name shown in the UI and the browser tab.
APP_NAME=Control Center
# Optional header emoji; leave blank to show the Control Center logo (default).
APP_ICON=
# Comma-separated entity domains assignable in Manage users (blank = all).
DEVICE_TYPES=light,switch,fan,climate,cover,lock,media_player

# The app listens on two ports (dev serves both):
#  INGRESS_PORT - the admin MANAGEMENT UI (in the add-on this is the sidebar).
#  USER_PORT    - the household device dashboard (app login).
INGRESS_PORT=4000
USER_PORT=8099
